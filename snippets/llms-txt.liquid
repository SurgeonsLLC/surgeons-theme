{%- comment -%} ============================================================
  LAYER 2: Dynamic product/collection context for current page
  Gives AI crawlers rich context about whatever page they're on.
============================================================ {%- endcomment -%}
{%- if request.page_type == 'product' -%}
<script type="application/llms+txt" id="llms-product-context">
# Product: {{ product.title | escape }}
> {{ product.description | strip_html | truncate: 300 | escape }}

- Price: {{ product.price | money }}
- Available: {% if product.available %}Yes — in stock{% else %}Currently out of stock{% endif %}
- Type: {{ product.type | default: 'CBD Product' | escape }}
- Vendor: {{ product.vendor | default: 'CBD Surgeons' | escape }}
{%- if product.selected_or_first_available_variant.sku != blank %}
- SKU: {{ product.selected_or_first_available_variant.sku | escape }}
{%- endif %}
- URL: {{ shop.url }}{{ product.url }}
- Ships from: Mount Clemens, Michigan
- Shipping: Free on orders over $100
- Returns: 30-day free returns
{%- if product.tags.size > 0 %}
- Tags: {{ product.tags | join: ', ' | escape }}
{%- endif %}
</script>
{%- endif -%}

{%- if request.page_type == 'collection' -%}
<script type="application/llms+txt" id="llms-collection-context">
# Collection: {{ collection.title | escape }}
> {{ collection.description | strip_html | truncate: 300 | default: 'Shop premium CBD products from CBD Surgeons.' | escape }}

- Products Available: {{ collection.products_count }}
- URL: {{ shop.url }}{{ collection.url }}
- Vendor: CBD Surgeons (surgeonsolution.io)

## Products in This Collection
{%- for p in collection.products limit: 20 %}
- {{ p.title | escape }} — {{ p.price | money }}{% if p.available %} (in stock){% endif %} — {{ shop.url }}{{ p.url }}
{%- endfor %}
</script>
{%- endif -%}

{%- if request.page_type == 'article' -%}
<script type="application/llms+txt" id="llms-article-context">
# Article: {{ article.title | escape }}
> {{ article.excerpt_or_content | strip_html | truncate: 500 | escape }}

- Author: {{ article.author | default: 'CBD Surgeons' | escape }}
- Published: {{ article.published_at | date: '%Y-%m-%d' }}
- URL: {{ shop.url }}{{ article.url }}
- Blog: {{ blog.title | escape }}
- Publisher: CBD Surgeons (surgeonsolution.io)
</script>
{%- endif -%}
