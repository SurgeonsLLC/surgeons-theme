{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign brand_name = settings.seo_brand_name | default: 'CBD Surgeons'
  assign enable_seo = settings.seo_enable_keywords | default: true

  comment
    Build enhanced SEO title based on page type
    OG title should match page title for consistency
  endcomment
  if enable_seo
    case request.page_type
      when 'index'
        if settings.seo_homepage_title != blank
          assign og_title = settings.seo_homepage_title
        elsif settings.seo_homepage_title_suffix != blank
          assign og_title = shop.name | append: ' ' | append: settings.seo_homepage_title_suffix
        endif
        if settings.seo_homepage_description != blank
          assign og_description = settings.seo_homepage_description
        endif
      when 'collection'
        if settings.seo_collection_title_prefix != blank
          assign og_title = settings.seo_collection_title_prefix | append: ' ' | append: collection.title
        endif
        if settings.seo_collection_title_suffix != blank
          assign og_title = og_title | append: ' ' | append: settings.seo_collection_title_suffix
        endif
        unless page_description != blank
          capture collection_desc
            echo 'Shop '
            echo collection.title
            echo ' online at '
            echo brand_name
            echo '. Buy premium '
            echo collection.title | downcase
            echo ' with fast shipping. Order now!'
          endcapture
          assign og_description = collection_desc
        endunless
      when 'product'
        if settings.seo_product_title_suffix != blank
          assign og_title = product.title | append: ' ' | append: settings.seo_product_title_suffix
        endif
        unless page_description != blank
          capture product_desc
            echo 'Buy '
            echo product.title
            echo ' online.'
            if settings.seo_product_include_price and product.price > 0
              echo ' Starting at '
              echo product.price | money
              echo '.'
            endif
            if settings.seo_product_include_availability and product.available
              echo ' In stock - ships fast!'
            endif
            echo ' Shop '
            echo brand_name
            echo ' for premium CBD products.'
          endcapture
          assign og_description = product_desc
        endunless
    endcase
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
    elsif request.page_type == 'article'
      assign og_type = 'article'
    elsif request.page_type == 'password'
      assign og_url = request.origin
  endif
-%}
<!-- SEO: Enforce www canonical for surgeonsolution.io -->
{%- assign canonical_www = og_url | replace: '://surgeonsolution.io', '://www.surgeonsolution.io' -%}
<link rel="canonical" href="{{ canonical_www }}">
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_www }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
<!-- Additional SEO meta tags -->
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<meta name="author" content="CBD Surgeons">
<meta name="publisher" content="CBD Surgeons">
<meta name="keywords" content="lifted lollies, king palm wraps, delta 9 seltzer, hemp drink, cbd gummies for sleep, cbd flower for sale, cbd for eczema, cbd clinic pain relief ointment, best edible for pain and inflammation, cbd massage cream" />
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- endif -%}
{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">