    <!-- Surgeons Security: Domain Allowlist Configuration (Extended by Security Suite v2.0) -->
    <script>
    window.SurgeonsSecurity = {
      version: '2.0.0',
      allowedDomains: [
        // Surgeons Solutions Infrastructure
        'surgeonsolutions.org',
        'ai.surgeonsolutions.org',
        'cdn.surgeonsolutions.org',
        'edge.surgeonsolutions.org',
        'waf.surgeonsolutions.org',
        // Surgeons Solution Store
        'surgeonsolution.io',
        'www.surgeonsolution.io',
        'records.surgeonsolution.io',
        'accounts.surgeonsolution.io',
        'realsurgeons.accounts.surgeonsolution.io',
        // Partner Domains
        'cbdsurgeons.shop',
        'onlythebestherbs.io',
        // Google Services
        'apis.google.com',
        // Shopify Infrastructure
        'shopify.com',
        'cdn.shopify.com',
        'monorail-edge.shopifysvc.com'
      ],

      isAllowedDomain: function(url) {
        try {
          var parsed = new URL(url);
          var hostname = parsed.hostname.toLowerCase();
          return this.allowedDomains.some(function(domain) {
            return hostname === domain || hostname.endsWith('.' + domain);
          });
        } catch (e) {
          console.warn('[Surgeons Security] Invalid URL:', url);
          return false;
        }
      },

      secureFetch: function(url, options) {
        if (!this.isAllowedDomain(url)) {
          console.error('[Surgeons Security] Blocked request to unauthorized domain:', url);
          return Promise.reject(new Error('Domain not in allowlist: ' + url));
        }
        return fetch(url, options);
      },

      secureXHR: function(method, url, async) {
        if (!this.isAllowedDomain(url)) {
          console.error('[Surgeons Security] Blocked XHR to unauthorized domain:', url);
          throw new Error('Domain not in allowlist: ' + url);
        }
        var xhr = new XMLHttpRequest();
        xhr.open(method, url, async !== false);
        return xhr;
      },

      log: function(message, data) {
        if (window.location.hostname === 'localhost' || window.location.search.includes('debug=true')) {
          console.log('[Surgeons Security]', message, data || '');
        }
      }
    };

    // Log security initialization
    window.SurgeonsSecurity.log('Security module initialized', {
      allowedDomains: window.SurgeonsSecurity.allowedDomains.length + ' domains configured'
    });
    </script>
