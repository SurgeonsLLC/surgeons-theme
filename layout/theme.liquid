{% comment %} Surgeons AI SEO Injection Loader {% endcomment %}
<script>
(function() {
  'use strict';
  var SURGEONS_API = 'https://ai.surgeonsolutions.org';

  function loadSEOInjections() {
    var domain = window.location.hostname.toLowerCase();
    var path = window.location.pathname || '/';
    var url = SURGEONS_API + '/api/inject/seo?domain=' + encodeURIComponent(domain) + '&path=' + encodeURIComponent(path);

    fetch(url, { method: 'GET', mode: 'cors', headers: { 'Accept': 'application/json' }})
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (!data.ok || !data.injections) return;
      data.injections.forEach(function(inj) {
        if (!inj.code) return;
        var c = document.createElement('div');
        c.innerHTML = inj.code;
        var t = inj.placement === 'body' ? document.body : document.head;
        while (c.firstChild) {
          if (c.firstChild.nodeType === 1) c.firstChild.setAttribute('data-surgeons-seo', inj.id);
          t.appendChild(c.firstChild);
        }
      });
    }).catch(function(e) { console.error('[Surgeons SEO]', e); });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', loadSEOInjections);
  else loadSEOInjections();
})();
</script>

