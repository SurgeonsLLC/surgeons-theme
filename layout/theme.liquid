<script id="merchantWidgetScript" src="https://www.gstatic.com/shopping/merchant/merchantwidget.js" defer></script>
<script>
  document.getElementById('merchantWidgetScript').addEventListener('load', function() {
    merchantwidget.start({
      merchant_id: 5586792336,
      position: "BOTTOM_LEFT",
      region: "US"
    });

    // Force-reposition the Google badge iframe to bottom-left
    var observer = new MutationObserver(function(mutations) {
      var iframes = document.querySelectorAll('iframe[src*="merchantwidget"], iframe[src*="google.com/shopping"]');
      var isMobile = window.innerWidth <= 768;
      var leftVal = isMobile ? '8px' : '0px';
      var maxW = isMobile ? (window.innerWidth - 16) + 'px' : '100vw';
      iframes.forEach(function(iframe) {
        var parent = iframe.parentElement;
        if (parent && parent.style) {
          parent.style.setProperty('left', leftVal, 'important');
          parent.style.setProperty('right', 'auto', 'important');
          parent.style.setProperty('max-width', maxW, 'important');
        }
        iframe.style.setProperty('left', leftVal, 'important');
        iframe.style.setProperty('right', 'auto', 'important');
        iframe.style.setProperty('max-width', maxW, 'important');
      });
      // Also catch any fixed-position divs Google creates
      document.querySelectorAll('div[style*="position: fixed"][style*="bottom"]').forEach(function(el) {
        if (el.querySelector('iframe[src*="google"]') || el.querySelector('iframe[src*="merchant"]')) {
          el.style.setProperty('left', leftVal, 'important');
          el.style.setProperty('right', 'auto', 'important');
          el.style.setProperty('max-width', maxW, 'important');
        }
      });
    });
    observer.observe(document.body, { childList: true, subtree: true, attributes: true });

    // Disconnect observer after 10s to avoid ongoing overhead
    setTimeout(function() { observer.disconnect(); }, 10000);
  });
</script>

