<!-- Surgeons Bot Detection v1.0 -->
<script>
(function(){
  var BD_KEY = 'sg_bot_score';
  var BD_FLAGS_KEY = 'sg_bot_flags';
  var score = 0;
  var flags = [];

  // 1. Webdriver / Automation Detection
  if (navigator.webdriver) { score += 40; flags.push('webdriver'); }
  if (window.__nightmare) { score += 40; flags.push('nightmare'); }
  if (window.callPhantom || window._phantom) { score += 40; flags.push('phantom'); }
  if (window.chrome && !window.chrome.runtime) { score += 20; flags.push('headless_chrome'); }

  // 2. Missing browser features (common in bots)
  if (!navigator.languages || navigator.languages.length === 0) { score += 15; flags.push('no_languages'); }
  if (!window.localStorage) { score += 20; flags.push('no_localstorage'); }
  if (navigator.plugins && navigator.plugins.length === 0 && !/mobile|android|iphone/i.test(navigator.userAgent)) { score += 15; flags.push('no_plugins'); }

  // 3. Screen/window anomalies
  if (screen.width === 0 || screen.height === 0) { score += 30; flags.push('no_screen'); }
  if (window.outerWidth === 0 || window.outerHeight === 0) { score += 25; flags.push('zero_window'); }

  // 4. User agent checks
  var ua = navigator.userAgent.toLowerCase();
  var botPatterns = /bot|crawl|spider|scrape|headless|phantom|selenium|puppeteer|playwright|wget|curl|python|java\//;
  if (botPatterns.test(ua)) { score += 35; flags.push('bot_ua'); }

  // 5. Timing anomalies (page load too fast)
  var loadStart = performance.timing ? performance.timing.navigationStart : Date.now();
  setTimeout(function(){
    var loadTime = Date.now() - loadStart;
    if (loadTime < 100) { score += 20; flags.push('instant_load'); }
  }, 50);

  // 6. Behavior tracking (no interaction = suspicious)
  var hasInteracted = false;
  var interactionHandler = function() {
    hasInteracted = true;
    score = Math.max(0, score - 10); // Reduce score on real interaction
    localStorage.setItem(BD_KEY, score);
    document.removeEventListener('mousemove', interactionHandler);
    document.removeEventListener('touchstart', interactionHandler);
    document.removeEventListener('keydown', interactionHandler);
    document.removeEventListener('scroll', interactionHandler);
  };
  document.addEventListener('mousemove', interactionHandler, {once: true, passive: true});
  document.addEventListener('touchstart', interactionHandler, {once: true, passive: true});
  document.addEventListener('keydown', interactionHandler, {once: true, passive: true});
  document.addEventListener('scroll', interactionHandler, {once: true, passive: true});

  // Check after 5 seconds if no interaction
  setTimeout(function(){
    if (!hasInteracted) { score += 15; flags.push('no_interaction_5s'); localStorage.setItem(BD_KEY, score); localStorage.setItem(BD_FLAGS_KEY, JSON.stringify(flags)); }
  }, 5000);

  // Store results
  localStorage.setItem(BD_KEY, score);
  localStorage.setItem(BD_FLAGS_KEY, JSON.stringify(flags));

  // Expose for attribution integration
  window.SurgeonsBotDetection = {
    getScore: function() { return parseInt(localStorage.getItem(BD_KEY)) || 0; },
    getFlags: function() { try { return JSON.parse(localStorage.getItem(BD_FLAGS_KEY)) || []; } catch(e) { return []; } },
    isLikelyBot: function() { return this.getScore() >= 30; },
    getData: function() { return { bot_score: this.getScore(), bot_flags: this.getFlags().join(','), is_bot: this.isLikelyBot() }; }
  };

  // Integrate with cart attributes for order filtering
  if (window.SurgeonsAttribution) {
    var origGetData = window.SurgeonsAttribution.getData;
    window.SurgeonsAttribution.getData = function() {
      var data = origGetData();
      var botData = window.SurgeonsBotDetection.getData();
      data.bot_score = botData.bot_score;
      data.bot_flags = botData.bot_flags;
      data.is_bot = botData.is_bot ? 'true' : 'false';
      return data;
    };
  }

  // Log for debugging (only in dev)
  if (window.location.hostname === 'localhost' || window.location.search.includes('debug=true')) {
    console.log('[Surgeons Bot Detection]', { score: score, flags: flags, isLikelyBot: score >= 30 });
  }
})();
</script>
