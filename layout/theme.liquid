<!-- ========================================
     BUD Chat Widget v0.2 - CBD Surgeons (Performance Optimized)
     Implemented: 2025-12-22 | Perf Update: 2026-01-12
     Strategy: Facade pattern - loads on user interaction
     Saves ~50-100KB on initial page load
     ======================================== -->
<div id="bud-chat-facade" style="position:fixed;bottom:20px;right:20px;width:60px;height:60px;background:linear-gradient(135deg,#2563eb,#7c3aed);border-radius:50%;cursor:pointer;z-index:9998;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(37,99,235,0.4);transition:transform .2s,box-shadow .2s;" aria-label="Open chat">
  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
</div>
<script>
(function(){
  var facade = document.getElementById('bud-chat-facade');
  var loaded = false;

  function loadChatbot() {
    if (loaded) return;
    loaded = true;
    facade.style.display = 'none';

    var script = document.createElement('script');
    script.src = 'https://ai.surgeonsolutions.org/api/chatbot/loader.js';
    script.onload = function() {
      // Trigger chat open after load
      if (window.BUDChat && window.BUDChat.open) {
        setTimeout(function() { window.BUDChat.open(); }, 100);
      }
    };
    document.body.appendChild(script);
  }

  // Load on click
  facade.addEventListener('click', loadChatbot);

  // Load on hover (desktop preload)
  facade.addEventListener('mouseenter', function() {
    if (!loaded && window.innerWidth > 768) {
      loadChatbot();
    }
  }, { once: true });

  // Load during idle time after 5 seconds (background preload)
  if ('requestIdleCallback' in window) {
    setTimeout(function() {
      requestIdleCallback(function() {
        if (!loaded) loadChatbot();
      }, { timeout: 3000 });
    }, 5000);
  }
})();
</script>

