<html class="no-js fouc-guard" lang="{{ request.locale.iso_code }}">
  <head>
    <!-- FOUC Prevention - MUST be first in head -->
    <style>.fouc-guard{opacity:0!important}.fouc-ready{opacity:1!important;transition:opacity .1s ease-in}</style>
    <script>setTimeout(function(){document.documentElement.classList.remove('fouc-guard');document.documentElement.classList.add('fouc-ready')},150);</script>

    <!-- Critical CSS: Above-the-fold styles inlined for instant render -->
    <style>
      /* Layout primitives */
      *,*::before,*::after{box-sizing:border-box}
      html{font-size:62.5%;-webkit-text-size-adjust:100%;scroll-behavior:smooth}
      body{margin:0;font-family:var(--body-font-family,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif);font-size:var(--body-font-size,1.6rem);line-height:1.6;color:var(--text-color,#111);background:var(--bg-color,#fff)}
      img,video{max-width:100%;height:auto;display:block}
      .hidden{display:none!important}
      .visually-hidden{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;border:0!important}

      /* Header skeleton */
      .header{position:sticky;top:0;z-index:1000;background:var(--header-bg,#fff)}
      .header-wrapper{display:flex;align-items:center;justify-content:space-between;padding:1rem 2rem;max-width:1440px;margin:0 auto}

      /* Hero/carousel skeleton - prevents CLS */
      .carousel-section,.hero-section{min-height:50vh;position:relative;overflow:hidden}
      .splide__slide{min-height:inherit}
      .carousel-card{width:100%;height:100%;object-fit:cover}

      /* Button primitives */
      .button{display:inline-flex;align-items:center;justify-content:center;padding:1.2rem 2.4rem;border:none;border-radius:var(--btn-radius,4px);font-weight:600;cursor:pointer;transition:transform .15s,opacity .15s}
      .button:active{transform:scale(.98)}

      /* Product grid skeleton */
      .product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:2rem}
      .product-card{aspect-ratio:3/4;background:#f5f5f5;border-radius:8px}

      /* Loading states */
      @keyframes shimmer{0%{background-position:-200% 0}100%{background-position:200% 0}}
      .loading-skeleton{background:linear-gradient(90deg,#f0f0f0 25%,#e0e0e0 50%,#f0f0f0 75%);background-size:200% 100%;animation:shimmer 1.5s infinite}

      /* Mobile-first responsive */
      @media(min-width:768px){.header-wrapper{padding:1.5rem 4rem}}
      @media(min-width:992px){.product-grid{grid-template-columns:repeat(4,1fr)}}
    </style>
