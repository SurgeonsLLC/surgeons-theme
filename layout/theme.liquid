        urgency.style.cssText = 'background:#fef2f2;color:#dc2626;padding:8px 16px;border-radius:8px;font-size:14px;font-weight:600;margin:12px 0;display:inline-block;animation:bud-pulse 2s infinite;';
        el.parentNode.insertBefore(urgency, el.nextSibling);
      }
    });

    // Add "selling fast" badge to popular products
    var productCards = document.querySelectorAll('.product-card, .card-product');
    productCards.forEach(function(card, index) {
      if (index < 3) { // Top 3 products
        var badge = card.querySelector('.sg-hot-badge');
        if (!badge) {
          badge = document.createElement('span');
          badge.className = 'sg-hot-badge';
          badge.innerHTML = '🔥 Popular';
