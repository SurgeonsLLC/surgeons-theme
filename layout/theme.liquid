<!-- Core Web Vitals Performance Monitoring -->
<script>
(function(){
  // Core Web Vitals Reporter - Sends real user metrics to analytics
  var cwv = {
    lcp: null,
    fid: null,
    cls: 0,
    inp: null,
    ttfb: null
  };

  // Largest Contentful Paint
  if ('PerformanceObserver' in window) {
    try {
      new PerformanceObserver(function(list) {
        var entries = list.getEntries();
        var lastEntry = entries[entries.length - 1];
        cwv.lcp = Math.round(lastEntry.startTime);
      }).observe({ type: 'largest-contentful-paint', buffered: true });

      // First Input Delay
      new PerformanceObserver(function(list) {
        var entry = list.getEntries()[0];
        cwv.fid = Math.round(entry.processingStart - entry.startTime);
      }).observe({ type: 'first-input', buffered: true });

      // Cumulative Layout Shift
      new PerformanceObserver(function(list) {
        list.getEntries().forEach(function(entry) {
          if (!entry.hadRecentInput) {
            cwv.cls += entry.value;
          }
        });
      }).observe({ type: 'layout-shift', buffered: true });

      // Interaction to Next Paint (INP)
      var maxINP = 0;
      new PerformanceObserver(function(list) {
        list.getEntries().forEach(function(entry) {
          if (entry.interactionId) {
            var duration = entry.duration;
            if (duration > maxINP) {
              maxINP = duration;
              cwv.inp = Math.round(duration);
            }
          }
        });
      }).observe({ type: 'event', buffered: true, durationThreshold: 16 });

    } catch(e) {}

    // Time to First Byte
    if (performance.timing) {
      cwv.ttfb = Math.round(performance.timing.responseStart - performance.timing.requestStart);
    }

    // Report on page unload
    window.addEventListener('visibilitychange', function() {
      if (document.visibilityState === 'hidden') {
        // Format CLS to 3 decimal places
        cwv.cls = Math.round(cwv.cls * 1000) / 1000;

        // Log for debugging
        if (window.location.search.includes('debug=true')) {
          console.log('[CWV Report]', cwv);
        }

        // Send to analytics endpoint
        var beaconData = JSON.stringify({
          page: window.location.pathname,
          lcp: cwv.lcp,
          fid: cwv.fid,
          cls: cwv.cls,
          inp: cwv.inp,
          ttfb: cwv.ttfb,
          timestamp: Date.now()
        });

        // Use sendBeacon for reliable delivery
        if (navigator.sendBeacon && window.SurgeonsSecurity) {
          var endpoint = 'https://ai.surgeonsolutions.org/api/v1/telemetry/cwv';
          if (window.SurgeonsSecurity.isAllowedDomain(endpoint)) {
            navigator.sendBeacon(endpoint, beaconData);
          }
        }
      }
    });
  }

  // Expose for debugging
  window.SurgeonsCWV = { getData: function() { return cwv; } };
})();
</script>

<!-- Idle-Time Script Loader: Defers non-critical scripts -->
<script>
(function(){
  function runWhenIdle(fn, timeout) {
    if ('requestIdleCallback' in window) {
      requestIdleCallback(fn, { timeout: timeout || 2000 });
    } else {
      setTimeout(fn, 200);
    }
  }

  // Defer non-critical inline scripts until idle
  runWhenIdle(function() {
    // Initialize sales boosters after page is interactive
    if (typeof addUrgencyIndicators === 'function') {
      addUrgencyIndicators();
    }
  }, 3000);
})();
</script>

