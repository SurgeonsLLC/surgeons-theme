{%- comment -%}
  SEO Hero Section - CBD Surgeons

  This section provides a proper H1 tag for the homepage with transactional keywords.
  Critical for SEO: Every page should have exactly ONE H1 tag.

  Place this section at the top of your homepage.
{%- endcomment -%}

{%- liquid
  assign section_scheme_class = section.settings.color_scheme | prepend: 'scheme scheme--'

  capture section_container_layout
    case section.settings.container_layout
      when 'page-width'
        echo 'container'
      when 'contained-content'
        echo 'contained-container'
      when 'container-fluid'
        echo 'container-fluid'
    endcase
  endcapture
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .seo-hero {
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
  }

  .seo-hero_wrapper {
    text-align: {{ section.settings.text_align }};
  }

  .seo-hero_heading {
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .seo-hero_subheading {
    margin: 0 0 24px;
    max-width: 800px;
    {% if section.settings.text_align == 'center' %}
    margin-left: auto;
    margin-right: auto;
    {% endif %}
  }

  .seo-hero_cta {
    display: inline-flex;
    gap: 12px;
    flex-wrap: wrap;
    {% if section.settings.text_align == 'center' %}
    justify-content: center;
    {% endif %}
  }

  @media (max-width: 749px) {
    .seo-hero_heading {
      font-size: calc(var(--h1-size) * 0.75);
    }
  }
{%- endstyle -%}

<section class="seo-hero {{ section_scheme_class }}">
  <div class="{{ section_container_layout }}">
    <div class="seo-hero_wrapper">
      {%- if section.settings.caption != blank -%}
        <p class="seo-hero_caption text-size--small --fw-semi-bold --text-alternative" style="margin:0 0 8px;letter-spacing:0.1em;text-transform:uppercase;">
          {{ section.settings.caption }}
        </p>
      {%- endif -%}

      {%- comment -%} SEO: This is the PRIMARY H1 for the homepage {%- endcomment -%}
      <h1 class="seo-hero_heading {{ section.settings.heading_size }} {{ section.settings.heading_weight }}">
        {{ section.settings.heading  }}
      </h1>

      {%- if section.settings.subheading != blank -%}
        <p class="seo-hero_subheading {{ section.settings.text_size }} {{ section.settings.text_weight }}">
          {{ section.settings.subheading }}
        </p>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
        <div class="seo-hero_cta">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="button button--primary">
              {{ section.settings.button_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a href="{{ section.settings.button_link_2 }}" class="button button--secondary">
              {{ section.settings.button_label_2 }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} Trust indicators for SEO and conversion {%- endcomment -%}
      {%- if section.settings.show_trust_text -%}
        <p class="seo-hero_trust text-size--small --text-alternative" style="margin:24px 0 0;display:flex;align-items:center;gap:8px;{% if section.settings.text_align == 'center' %}justify-content:center;{% endif %}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:#10b981;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          <span>{{ section.settings.trust_text | default: 'Lab Tested • Fast Shipping • Satisfaction Guaranteed' }}</span>
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SEO Hero (H1)",
  "tag": "section",
  "class": "seo-hero-section",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "SEO Content"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption (above heading)",
      "default": "CBD Surgeons"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "H1 Heading (Primary)",
      "default": "CBD Surgeons | CBD Oil, Gummies & Hemp | Michigan USA",
      "info": "This is the main H1 for SEO. Include transactional keywords like 'buy', 'shop', 'order'."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Buy lab-tested CBD gummies, hemp flower, topicals & more. Fast shipping on all orders. Michigan's trusted CBD source since 2022."
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "View Collections"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Trust Signals"
    },
    {
      "type": "checkbox",
      "id": "show_trust_text",
      "label": "Show trust text",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust text",
      "default": "Lab Tested • Fast Shipping • Satisfaction Guaranteed"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "Extra Large" },
        { "value": "h2", "label": "Large" },
        { "value": "h3", "label": "Medium" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "--fw-extra-bold", "label": "Extra Bold" },
        { "value": "--fw-bold", "label": "Bold" },
        { "value": "--fw-semi-bold", "label": "Semi Bold" }
      ],
      "default": "--fw-extra-bold"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Subheading size",
      "options": [
        { "value": "text-size--medium", "label": "Medium" },
        { "value": "text-size--large", "label": "Large" },
        { "value": "text-size--xlarge", "label": "Extra Large" }
      ],
      "default": "text-size--large"
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Subheading weight",
      "options": [
        { "value": "--fw-normal", "label": "Normal" },
        { "value": "--fw-medium", "label": "Medium" }
      ],
      "default": "--fw-normal"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "container_layout",
      "label": "Container width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "contained-content", "label": "Contained" },
        { "value": "container-fluid", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "SEO Hero (H1)",
      "settings": {
        "caption": "CBD Surgeons",
        "heading": "",
        "subheading": "Buy lab-tested CBD gummies, hemp flower, topicals & more. Fast shipping on all orders. Michigan's trusted CBD source since 2022.",
        "button_label": "Shop Now",
        "button_label_2": "View Collections",
        "show_trust_text": true
      }
    }
  ]
}
{% endschema %}
