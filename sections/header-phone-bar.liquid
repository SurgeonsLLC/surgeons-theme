{%- liquid
  assign section_prefix_class = 'phone-bar'
  assign section_scheme_class = section.settings.section_color_scheme | prepend: 'scheme scheme--'
  assign phone_digits = section.settings.phone_number | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
-%}
{%- style -%}
  .phone-bar {
    --section-padding-top: 8px;
    --section-padding-bottom: 8px;
  }

  .phone-bar_wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 15px;
    gap: 20px;
    flex-wrap: wrap;
  }

  .phone-bar_link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--section-links-color);
    text-decoration: none;
    font-family: var(--font-headings-family);
    font-weight: 600;
    font-size: 14px;
    padding: 6px 12px;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .phone-bar_link:hover {
    color: var(--section-active-hover-color);
    background-color: rgba(255, 255, 255, 0.1);
  }

  .phone-bar_icon {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
  }

  .phone-bar_text {
    white-space: nowrap;
    letter-spacing: 0.5px;
  }

  .phone-bar_label {
    color: var(--section-text-color);
    font-size: 13px;
    opacity: 0.85;
  }

  @media (max-width: 575px) {
    .phone-bar_label {
      display: none;
    }

    .phone-bar_link {
      font-size: 15px;
      padding: 8px 16px;
    }
  }
{%- endstyle -%}

<div class="global-block {{ section_prefix_class }} {{ section_prefix_class }}-{{ section.id }} {{ section_scheme_class }}">
  <div class="{{ section_prefix_class }}_wrapper">
    {%- if section.settings.label_text != blank -%}
      <span class="{{ section_prefix_class }}_label">{{ section.settings.label_text }}</span>
    {%- endif -%}
    <a href="tel:{{ phone_digits }}" class="{{ section_prefix_class }}_link" aria-label="Call us at {{ section.settings.phone_number }}">
      <svg class="{{ section_prefix_class }}_icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="{{ section_prefix_class }}_text">{{ section.settings.phone_number }}</span>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Phone Bar",
  "tag": "div",
  "limit": 1,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone number",
      "default": "(586) 576-1313",
      "info": "Clickable - opens phone dialer on mobile devices"
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Label text (optional)",
      "default": "Call Us Today:",
      "info": "Text shown before the phone number"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "default": "scheme1",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Phone Bar"
    }
  ]
}
{% endschema %}
